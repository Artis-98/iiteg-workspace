# Run npm run setup to generate a private .env with random secrets.
DB_HOST=db
DB_PORT=3306
DB_NAME=workspace
DB_USER=workspace
DB_PASSWORD=change-me-to-a-unique-random-value
DB_ROOT_PASSWORD=change-me-to-another-unique-random-value
APP_KEY=change-me-generate-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Workspace Owner
ADMIN_PASSWORD=change-me-use-at-least-12-characters
PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_ORIGIN=
